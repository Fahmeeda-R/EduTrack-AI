<script>
  let activeRole = 'student';

  function switchAuthTab(tab) {
    const loginSection = document.getElementById('login-section');
    const regSection = document.getElementById('register-section');
    const loginBtn = document.getElementById('tab-login-btn');
    const regBtn = document.getElementById('tab-register-btn');
    const alertBox = document.getElementById('auth-alert');

    alertBox.classList.add('hidden');

    if (tab === 'login') {
      loginSection.classList.remove('hidden');
      regSection.classList.add('hidden');
      loginBtn.className = 'relative z-10 py-2.5 rounded-md font-label-md text-label-md text-on-primary bg-primary shadow-sm transition-all duration-200 flex items-center justify-center gap-1.5';
      regBtn.className = 'relative z-10 py-2.5 rounded-md font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-all duration-200 flex items-center justify-center gap-1.5';
    } else {
      loginSection.classList.add('hidden');
      regSection.classList.remove('hidden');
      regBtn.className = 'relative z-10 py-2.5 rounded-md font-label-md text-label-md text-on-primary bg-primary shadow-sm transition-all duration-200 flex items-center justify-center gap-1.5';
      loginBtn.className = 'relative z-10 py-2.5 rounded-md font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-all duration-200 flex items-center justify-center gap-1.5';
    }
  }

  function setLoginRole(role) {
    activeRole = role;
    const studentBtn = document.getElementById('role-login-student');
    const facultyBtn = document.getElementById('role-login-faculty');

    if (role === 'student') {
      studentBtn.className = 'py-2 px-3 rounded-lg text-left flex items-center gap-2.5 bg-secondary-fixed/40 text-on-secondary-fixed-variant font-label-md text-label-md transition-all';
      studentBtn.querySelector('span').className = 'w-2.5 h-2.5 rounded-full bg-primary inline-block';

      facultyBtn.className = 'py-2 px-3 rounded-lg text-left flex items-center gap-2.5 bg-surface-container text-on-surface-variant font-label-md text-label-md transition-all hover:bg-surface-container-high';
      facultyBtn.querySelector('span').className = 'w-2.5 h-2.5 rounded-full bg-outline-variant inline-block';
      triggerToast('Switched to Student Portal context', 'info');
    } else {
      facultyBtn.className = 'py-2 px-3 rounded-lg text-left flex items-center gap-2.5 bg-secondary-fixed/40 text-on-secondary-fixed-variant font-label-md text-label-md transition-all';
      facultyBtn.querySelector('span').className = 'w-2.5 h-2.5 rounded-full bg-primary inline-block';

      studentBtn.className = 'py-2 px-3 rounded-lg text-left flex items-center gap-2.5 bg-surface-container text-on-surface-variant font-label-md text-label-md transition-all hover:bg-surface-container-high';
      studentBtn.querySelector('span').className = 'w-2.5 h-2.5 rounded-full bg-outline-variant inline-block';
      triggerToast('Switched to Faculty/Instructor view', 'info');
    }
  }

  function quickFillDemo(role) {
    const emailInput = document.getElementById('login-email');
    const pwdInput = document.getElementById('login-password');
    if (role === 'student') {
      setLoginRole('student');
      emailInput.value = 'maya.lin@columbia.edu';
      pwdInput.value = 'DemoPass2025!';
      triggerToast('Student credentials filled (Maya Lin - Year 3 CS)', 'success');
    } else {
      setLoginRole('faculty');
      emailInput.value = 'prof.thorne@columbia.edu';
      pwdInput.value = 'FacultySecure#99';
      triggerToast('Faculty credentials filled (Prof. Thorne - Dept CS)', 'success');
    }
  }

  function togglePasswordVisibility(fieldId, btnElem) {
    const input = document.getElementById(fieldId);
    const icon = btnElem.querySelector('.material-symbols-outlined');
    if (input.type === 'password') {
      input.type = 'text';
      icon.textContent = 'visibility_off';
    } else {
      input.type = 'password';
      icon.textContent = 'visibility';
    }
  }

  function evaluatePasswordStrength(val) {
    const b1 = document.getElementById('bar-1');
    const b2 = document.getElementById('bar-2');
    const b3 = document.getElementById('bar-3');
    const lbl = document.getElementById('strength-label');

    // Reset bars
    b1.className = 'h-full flex-1 bg-surface-container-highest transition-all duration-300';
    b2.className = 'h-full flex-1 bg-surface-container-highest transition-all duration-300';
    b3.className = 'h-full flex-1 bg-surface-container-highest transition-all duration-300';

    if (!val || val.length === 0) {
      lbl.textContent = 'Awaiting entry';
      lbl.className = 'font-semibold text-on-surface-variant';
      return;
    }

    if (val.length < 6) {
      b1.className = 'h-full flex-1 bg-error transition-all duration-300';
      lbl.textContent = 'Weak';
      lbl.className = 'font-semibold text-error';
    } else if (val.length < 10) {
      b1.className = 'h-full flex-1 bg-secondary transition-all duration-300';
      b2.className = 'h-full flex-1 bg-secondary transition-all duration-300';
      lbl.textContent = 'Medium (Muted Clay)';
      lbl.className = 'font-semibold text-secondary';
    } else {
      b1.className = 'h-full flex-1 bg-primary transition-all duration-300';
      b2.className = 'h-full flex-1 bg-primary transition-all duration-300';
      b3.className = 'h-full flex-1 bg-primary transition-all duration-300';
      lbl.textContent = 'Strong Academic Grade';
      lbl.className = 'font-semibold text-primary';
    }
  }

  function handleRoleChange(val) {
    const notice = document.getElementById('faculty-notice');
    if (val === 'faculty') {
      notice.classList.remove('hidden');
    } else {
      notice.classList.add('hidden');
    }
  }

  function handleLoginSubmit(e) {
    e.preventDefault();
    const email = document.getElementById('login-email').value;
    if (!email.includes('@')) {
      triggerToast('Please provide a valid institutional email format.', 'error');
      return;
    }
    triggerToast('Authenticating with EduTrack Neural Network...', 'success');
  }

  function handleRegisterSubmit(e) {
    e.preventDefault();
    const p1 = document.getElementById('reg-password').value;
    const p2 = document.getElementById('reg-password-confirm').value;

    if (p1 !== p2) {
      triggerToast('Password confirmation does not match.', 'error');
      return;
    }
    triggerToast('Account generated! Confirmation sent to your university inbox.', 'success');
  }

  function triggerToast(message, type) {
    const alertBox = document.getElementById('auth-alert');
    const alertIcon = document.getElementById('alert-icon');
    const alertText = document.getElementById('alert-text');

    alertBox.classList.remove('hidden', 'bg-error-container', 'text-on-error-container', 'bg-secondary-fixed', 'text-on-secondary-fixed-variant', 'bg-surface-container-high', 'text-on-surface');
    alertBox.classList.add('flex');

    if (type === 'error') {
      alertBox.classList.add('bg-error-container', 'text-on-error-container');
      alertIcon.textContent = 'error';
    } else if (type === 'success') {
      alertBox.classList.add('bg-secondary-fixed', 'text-on-secondary-fixed-variant');
      alertIcon.textContent = 'check_circle';
    } else {
      alertBox.classList.add('bg-surface-container-high', 'text-on-surface');
      alertIcon.textContent = 'info';
    }

    alertText.textContent = message;
  }
</script></main></body></html>

