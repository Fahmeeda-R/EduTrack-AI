<script>
  (function () {
    const inputField = document.getElementById('tutor-prompt-input');
    const sendBtn = document.getElementById('submit-prompt-btn');
    const thread = document.getElementById('chat-thread');
    const toast = document.getElementById('tutor-toast');
    const toastMsg = document.getElementById('tutor-toast-msg');
    const typingIndicator = document.getElementById('ai-typing-indicator');

    function showToast(message) {
      if (!toast || !toastMsg) return;
      toastMsg.textContent = message;
      toast.classList.remove('opacity-0', '-translate-y-2');
      toast.classList.add('opacity-100', 'translate-y-0');
      setTimeout(() => {
        toast.classList.remove('opacity-100', 'translate-y-0');
        toast.classList.add('opacity-0', '-translate-y-2');
      }, 2200);
    }

    // Attach pill events
    document.querySelectorAll('.prompt-pill').forEach(btn => {
      btn.addEventListener('click', () => {
        const title = btn.querySelector('.font-label-md')?.textContent || '';
        if (inputField) {
          inputField.value = title;
          inputField.focus();
        }
      });
    });

    // Helper micro-actions
    document.getElementById('action-copy')?.addEventListener('click', () => {
      showToast('Explanation copied with references');
    });

    document.getElementById('action-flashcard')?.addEventListener('click', () => {
      showToast('Saved to CS 301 Flashcard Deck');
    });

    document.getElementById('action-simpler')?.addEventListener('click', () => {
      if (!typingIndicator) return;
      typingIndicator.classList.remove('hidden');
      setTimeout(() => {
        typingIndicator.classList.add('hidden');
        showToast('Created 3-bullet simplified analogy');
      }, 1100);
    });

    document.getElementById('copy-code-btn')?.addEventListener('click', () => {
      showToast('Code block copied to clipboard');
    });

    document.getElementById('attach-doc-btn')?.addEventListener('click', () => {
      showToast('File picker: Select lecture PDF or audio recording');
    });

    document.getElementById('voice-input-btn')?.addEventListener('click', () => {
      showToast('Listening... Speak your study question');
    });

    // Send logic
    function handleSend() {
      const query = inputField?.value?.trim();
      if (!query) return;

      const userBubble = document.createElement('div');
      userBubble.className = 'flex justify-end w-full pl-6';
      userBubble.innerHTML = `
        <div class="bg-primary text-on-primary rounded-2xl rounded-tr-sm p-space-md shadow-sm max-w-[92%] space-y-1">
          <div class="flex items-center justify-between gap-2 text-on-primary-container">
            <span class="font-label-sm text-label-sm opacity-90">Elena (Student)</span>
            <span class="font-code-sm text-code-sm opacity-80">Just now</span>
          </div>
          <p class="font-body-md text-body-md text-on-primary leading-snug">${query.replace(/</g, "&lt;").replace(/>/g, "&gt;")}</p>
        </div>
      `;
      thread?.appendChild(userBubble);
      inputField.value = '';

      if (typingIndicator) {
        typingIndicator.classList.remove('hidden');
        thread?.appendChild(typingIndicator);
        setTimeout(() => {
          typingIndicator.classList.add('hidden');
          showToast('Tutor response received');
        }, 1200);
      }
    }

    sendBtn?.addEventListener('click', handleSend);
    inputField?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        handleSend();
      }
    });
  })();
</script></main><nav class="fixed bottom-0 w-full z-50 pb-safe bg-surface/90 backdrop-blur-xl shadow-[0_-1px_12px_rgba(56,42,39,0.06)]" data-active-classes="text-primary font-bold"><div class="flex justify-around items-center h-20 px-space-sm max-w-lg mx-auto"><a class="flex flex-col items-center justify-center gap-1 min-w-[56px] h-14 rounded-lg text-on-surface-variant hover:text-on-surface transition-colors" data-path="dashboard" href="#"><span class="material-symbols-outlined text-[22px]">space_dashboard</span><span class="font-label-sm text-label-sm">Dashboard</span></a><a class="flex flex-col items-center justify-center gap-1 min-w-[56px] h-14 rounded-lg text-on-surface-variant hover:text-on-surface transition-colors" data-path="assignments" href="#"><span class="material-symbols-outlined text-[22px]">fact_check</span><span class="font-label-sm text-label-sm">Tasks</span></a><a class="flex flex-col items-center justify-center gap-1 min-w-[56px] h-14 rounded-lg text-on-surface-variant hover:text-on-surface transition-colors" data-path="calendar" href="#"><span class="material-symbols-outlined text-[22px]">calendar_today</span><span class="font-label-sm text-label-sm">Calendar</span></a><a class="flex flex-col items-center justify-center gap-1 min-w-[56px] h-14 rounded-lg text-on-surface-variant hover:text-on-surface transition-colors" data-path="ai-assistant" href="#"><span class="material-symbols-outlined text-[22px]">smart_toy</span><span class="font-label-sm text-label-sm">Tutor AI</span></a><button aria-label="Open drawer" class="flex flex-col items-center justify-center gap-1 min-w-[56px] h-14 rounded-lg text-on-surface-variant hover:text-on-surface transition-colors" id="open-drawer-btn" type="button"><span class="material-symbols-outlined text-[22px]">menu</span><span class="font-label-sm text-label-sm">Menu</span></button></div></nav><script>const openBtn=document.getElementById('open-drawer-btn');const closeBtn=document.getElementById('close-drawer-btn')