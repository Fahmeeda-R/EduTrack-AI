<script>
  // Simple micro-interaction for Focus Timer Toggle
  let timerActive = false;
  let timerSeconds = 25 * 60;
  let timerInterval = null;
  const timerBtn = document.getElementById('timer-start-btn');
  const timerDisplay = document.getElementById('timer-display');
  const timerIcon = document.getElementById('timer-action-icon');

  function updateTimerText() {
    const mins = Math.floor(timerSeconds / 60);
    const secs = timerSeconds % 60;
    timerDisplay.textContent = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
  }

  if (timerBtn) {
    timerBtn.addEventListener('click', () => {
      timerActive = !timerActive;
      if (timerActive) {
        timerBtn.textContent = 'Pause';
        timerBtn.classList.replace('bg-secondary', 'bg-tertiary-container');
        timerIcon.textContent = 'pause';
        timerInterval = setInterval(() => {
          if (timerSeconds > 0) {
            timerSeconds--;
            updateTimerText();
          } else {
            clearInterval(timerInterval);
            timerActive = false;
            timerBtn.textContent = 'Restart';
            timerIcon.textContent = 'replay';
          }
        }, 1000);
      } else {
        clearInterval(timerInterval);
        timerBtn.textContent = 'Resume';
        timerBtn.classList.replace('bg-tertiary-container', 'bg-secondary');
        timerIcon.textContent = 'play_arrow';
      }
    });
  }

  // Lofi toggle interaction
  const lofiBtn = document.getElementById('lofi-toggle');
  const lofiText = document.getElementById('lofi-text');
  let lofiModes = ['Lofi: Library', 'Lofi: Rain', 'Lofi: Coffee Shop', 'Lofi: Off'];
  let lofiIdx = 0;
  if (lofiBtn && lofiText) {
    lofiBtn.addEventListener('click', () => {
      lofiIdx = (lofiIdx + 1) % lofiModes.length;
      lofiText.textContent = lofiModes[lofiIdx];
    });
  }

  // Plan Generator Feedback
  const regenBtn = document.getElementById('regen-btn');
  if (regenBtn) {
    regenBtn.addEventListener('click', () => {
      const origHtml = regenBtn.innerHTML;
      regenBtn.innerHTML = '<span class="material-symbols-outlined text-[18px] animate-spin">refresh</span><span>Recalculating Free Slots...</span>';
      setTimeout(() => {
        regenBtn.innerHTML = '<span class="material-symbols-outlined text-[18px]">check_circle</span><span>Plan Optimized!</span>';
        setTimeout(() => {
          regenBtn.innerHTML = origHtml;
        }, 1500);
      }, 1000);
    });
  }
