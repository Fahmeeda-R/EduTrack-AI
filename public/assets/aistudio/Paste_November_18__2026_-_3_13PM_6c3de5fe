  (function() {
    // Filter chip logic
    const filterChips = document.querySelectorAll('.filter-chip');
    const articles = document.querySelectorAll('[data-category-item]');

    filterChips.forEach(chip => {
      chip.addEventListener('click', () => {
        // Toggle chip active styling
        filterChips.forEach(c => {
          c.classList.remove('bg-primary', 'text-on-primary', 'shadow-sm');
          c.classList.add('bg-surface-container-high', 'text-on-surface');
        });
        chip.classList.remove('bg-surface-container-high', 'text-on-surface');
        chip.classList.add('bg-primary', 'text-on-primary', 'shadow-sm');

        const cat = chip.getAttribute('data-category');
        articles.forEach(article => {
          const itemCats = article.getAttribute('data-category-item').split(' ');
          if (cat === 'all' || itemCats.includes(cat)) {
            article.style.display = 'block';
          } else {
            article.style.display = 'none';
          }
        });
      });
    });

    // Search bar live filtering
    const searchInput = document.getElementById('announcement-search');
    const clearBtn = document.getElementById('clear-search-btn');

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        if (query.length > 0) {
          clearBtn.classList.remove('hidden');
        } else {
          clearBtn.classList.add('hidden');
        }

        articles.forEach(article => {
          const text = article.innerText.toLowerCase();
          if (text.includes(query)) {
            article.style.display = 'block';
          } else {
            article.style.display = 'none';
          }
        });
      });
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        searchInput.value = '';
        clearBtn.classList.add('hidden');
        articles.forEach(article => article.style.display = 'block');
      });
    }

    // RSVP Microinteraction
    const rsvpBtn = document.querySelector('.rsvp-btn');
    if (rsvpBtn) {
      rsvpBtn.addEventListener('click', () => {
        const isRegistered = rsvpBtn.classList.contains('bg-surface-container-high');
        if (!isRegistered) {
          rsvpBtn.classList.remove('bg-primary', 'text-on-primary');
          rsvpBtn.classList.add('bg-surface-container-high', 'text-on-surface');
          rsvpBtn.innerHTML = '<span class="material-symbols-outlined text-[18px] text-primary" style="font-variation-settings: \'FILL\' 1;">check_circle</span><span>RSVP Confirmed</span>';
        } else {
          rsvpBtn.classList.add('bg-primary', 'text-on-primary');
          rsvpBtn.classList.remove('bg-surface-container-high', 'text-on-surface');
          rsvpBtn.innerHTML = '<span class="material-symbols-outlined text-[18px]">how_to_reg</span><span>Register Attendance</span>';
        }
      });
    }

    // Bookmark Toggle
    const bookmarkButtons = document.querySelectorAll('button[aria-label="Bookmark Bulletin"]');
    bookmarkButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const icon = btn.querySelector('.material-symbols-outlined');
        if (icon.innerText === 'bookmark_border') {
          icon.innerText = 'bookmark';
          icon.classList.add('text-primary');
          icon.style.fontVariationSettings = "'FILL' 1";
        } else {
          icon.innerText = 'bookmark_border';
          icon.classList.remove('text-primary');
          icon.style.fontVariationSettings = "'FILL' 0";
        }
      });
    });
  })();
