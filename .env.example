# =========================================================================
# EduTrack AI - Environment Configuration
# =========================================================================

# -------------------------------------------------------------------------
# 1. Gemini AI API
# -------------------------------------------------------------------------
# GEMINI_API_KEY: Required for Gemini AI API calls (Tutor, Rubric, Study Planner)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The base URL where this app is hosted (e.g., http://localhost:3000)
APP_URL="http://localhost:3000"

# -------------------------------------------------------------------------
# 2. Supabase API & Auth Configuration
# -------------------------------------------------------------------------
# In your Supabase Dashboard: Project Settings -> API
# Project URL: e.g. https://your-project-id.supabase.co
SUPABASE_URL="https://liejeygccubmfkrzkobb.supabase.co"

# Public Anon Key: safe for client-side and public API requests
SUPABASE_ANON_KEY="your-anon-key-here"

# Service Role Secret: for server-side operations bypassing RLS (keep private!)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Frontend Vite variables (optional, for direct browser Supabase access)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# -------------------------------------------------------------------------
# 3. Supabase PostgreSQL Database Connection
# -------------------------------------------------------------------------
# In your Supabase Dashboard: Project Settings -> Database -> Connection string
#
# Option A: Connection URI (Recommended)
# Direct connection (port 5432) or Connection Pooler (port 6543 / 5432):
# e.g., postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres"

# Option B: Discrete Parameters (alternative to DATABASE_URL)
# SUPABASE_DB_HOST="db.[YOUR-PROJECT-ID].supabase.co"
# SUPABASE_DB_PORT="5432"
# SUPABASE_DB_NAME="postgres"
# SUPABASE_DB_USER="postgres"
# SUPABASE_DB_PASSWORD="your-db-password"
# DB_SSL="true"

# -------------------------------------------------------------------------
# 4. RAG & Web Search Engine Configuration
# -------------------------------------------------------------------------
# GEMINI_API_KEY (above): Powers LLM generation and text-embedding-004 vector embeddings.
# (Optional) BRAVE_SEARCH_API_KEY: External web search API key (Wikipedia + DuckDuckGo live search operate out-of-the-box with no key required).
# BRAVE_SEARCH_API_KEY=""
